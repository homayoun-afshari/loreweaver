{
  "name": "loreweaver",
  "private": true,
  "description": "Worldbuilding copilot for novelists.",
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "@langchain/anthropic": "1.5.12",
    "@langchain/core": "1.2.17",
    "drizzle-orm": "0.45.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "test": "pnpm --filter web test",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "measure:legacy": "pnpm --filter web exec tsx scripts/measure-legacy.ts",
    "benchmark": "pnpm --filter web exec tsx scripts/benchmark.ts",
    "measure:chat": "pnpm --filter web exec tsx scripts/measure-chat.ts",
    "ingest": "pnpm --filter web exec tsx scripts/ingest.ts",
    "eval": "pnpm --filter web exec tsx ../../evals/judge.ts",
    "eval:redteam": "pnpm --filter web exec tsx ../../evals/judge.ts --dataset redteam",
    "eval:labels": "pnpm --filter web exec tsx ../../evals/labels.ts",
    "eval:retrieval": "pnpm --filter web exec tsx ../../evals/retrieval.ts",
    "measure:retrieval": "pnpm --filter web exec tsx scripts/measure-retrieval.ts",
    "measure:search-tool": "pnpm --filter web exec tsx scripts/measure-search-tool.ts",
    "measure:agent": "pnpm --filter web exec tsx scripts/measure-agent.ts",
    "cost:report": "pnpm --filter web exec tsx ../../evals/cost-report.ts"
  }
}
