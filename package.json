{
  "name": "loreweaver",
  "private": true,
  "description": "Worldbuilding copilot for novelists.",
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "test": "pnpm --filter web test",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "measure:legacy": "pnpm --filter web exec tsx scripts/measure-legacy.ts",
    "benchmark": "pnpm --filter web exec tsx scripts/benchmark.ts",
    "measure:chat": "pnpm --filter web exec tsx scripts/measure-chat.ts"
  }
}
