# Copy to .env.local (never commit .env.local). The app refuses to start if any value is missing.

# Legacy CMS service. Local dev: the Docker container from docker-compose.yml. Later: the Cloud Run URL.
LEGACY_CMS_URL=http://localhost:8080
# Placeholder for local dev only. The real key goes in Vercel env vars and Google Secret Manager.
LEGACY_CMS_API_KEY=dev-local-key

# Anthropic API key for the model calls. Create a `dev` key in the Anthropic Console.
# Never commit a real value. Vercel Preview uses the dev key, Production uses a separate prod key.
ANTHROPIC_API_KEY=

# Postgres connection string. Local dev: the container from docker-compose.yml.
# Preview and Production: the Supabase pooled (transaction) connection string, set in Vercel.
DATABASE_URL=postgresql://loreweaver:loreweaver@localhost:5432/loreweaver

# Embedding provider for lore search (Voyage AI). Create a key in the Voyage AI dashboard.
# Never commit a real value. Set it in Vercel (Preview and Production) as well.
VOYAGE_API_KEY=
# The embedding model. Chunks and queries MUST use the same one; changing it means re-embedding all lore.
EMBEDDING_MODEL=voyage-4-lite

# Tracing (LangSmith). Optional: with LANGSMITH_TRACING unset or false, nothing is sent anywhere.
# LangChain reads these directly, so they are not part of the validated environment (lib/env.ts).
# A trace contains the author's question, the retrieved lore and the answer.
LANGSMITH_TRACING=true
# Create a service key in LangSmith (Settings > API Keys). Never commit a real value.
# Local dev and Vercel Preview use the `loreweaver-dev` key, Production uses the `loreweaver-prod` key.
LANGSMITH_API_KEY=
# The project the traces go to: `loreweaver-dev` locally and in Preview, `loreweaver-prod` in Production.
LANGSMITH_PROJECT=loreweaver-dev
# The workspace is in the EU region, which has its own API address (no trailing slash).
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# The workspace the service key writes to (Settings > Workspaces). Needed by a key that covers the
# whole organization, which is refused with 403 Forbidden without it.
LANGSMITH_WORKSPACE_ID=

# Agent: how many times the reflection step may send a draft back for a revision before the graph
# stops and answers with a caveat. Optional: the code falls back to 2 when it is not set.
AGENT_MAX_ITERATIONS=2

# Consumption limits of one visitor (see lib/usage). Optional: the defaults are used when not set.
# The most chat requests a visitor may start in one minute.
RATE_LIMIT_PER_MINUTE=10
# The most tokens (all kinds, all model calls) a visitor may spend in one UTC day.
DAILY_TOKEN_BUDGET=200000
